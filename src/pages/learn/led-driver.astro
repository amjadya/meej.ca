---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import SymbolDefs from "../../components/cards/SymbolDefs.astro";
import CardPic from "../../components/cards/CardPic.astro";
import { cards, sections } from "../../data/ledDriverCards";
import katex from "katex";
import "katex/dist/katex.min.css";

const sectionIndex = (s: string) => sections.indexOf(s);

// keeps a number on the same line as its unit
const nb = (s: string) => s.replace(/(\d) (?=[mkµ]?[VAΩWJ](?![a-zA-Z])|LED|eV)/g, "$1\u00a0");

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

// turns $...$ and $$...$$ into typeset math at build time, [text](url) into links, and escapes the rest
const tex = (s: string) =>
	s
		.split(/(\$\$[^$]+\$\$|\$[^$]+\$)/g)
		.map((part) =>
			part.startsWith("$$")
				? katex.renderToString(part.slice(2, -2), { displayMode: true, throwOnError: false })
				: part.startsWith("$")
					? katex.renderToString(part.slice(1, -1), { throwOnError: false })
					: esc(nb(part)).replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>'),
		)
		.join("");

// the first sentence of an answer is the verdict, shown large, and the rest is the reasoning
const splitAnswer = (a: string) => {
	const m = a.match(/^(.+?[.!?])\s+(.+)$/s);
	return m ? [m[1], m[2]] : [a, ""];
};
---

<BaseLayout
	title="LED Driver Cards | Amjad Yaghi"
	description="Self-study the basics for the LED driver we are using on the plane."
>
	<SymbolDefs />

	<div class="app" data-deck>
		<header class="top">
			<div class="toprow" data-aos="fade-up" data-aos-duration="1500">
				<a href="/" class="name">Amjad <b>Yaghi</b></a>
				<Nav />
			</div>
			<div class="rule" data-aos="fade-up" data-aos-duration="2000"></div>
		</header>

		<div class="titlebar" data-aos="fade-up" data-aos-duration="2000">
			<div class="title">
				<p class="kicker mono">Aerodesign payload</p>
				<h1>The beacon LED driver</h1>
				<p class="lede">Self-study the basics for the LED driver we are using on the plane.</p>
			</div>
			<div class="bar">
				<span class="count mono" data-count>{cards.length} cards</span>
				<button type="button" class="btn" data-prev>Previous</button>
				<button type="button" class="btn" data-next>Next</button>
			</div>
		</div>

		<ol class="strip" role="list" aria-label="Jump to a card" data-aos="fade-up" data-aos-duration="2500">
			{
				cards.map((c, i) => (
					<li>
						<button
							type="button"
							class={`tick s${sectionIndex(c.section)}`}
							data-jump={i}
							title={`Card ${i + 1}: ${c.section}`}
							aria-label={`Card ${i + 1}`}
						/>
					</li>
				))
			}
		</ol>

		<div class="stage" data-aos="fade-up" data-aos-duration="2500">
			{
				cards.map((c, i) => (
					<article class="card" id={`card-${i + 1}`} data-card={i}>
						<figure class="pic">
							<CardPic pic={c.pic} />
						</figure>
						<div class="side">
							<div class="meta mono">
								<span class="tags">
									<span class={`chip s${sectionIndex(c.section)}`}>{c.section}</span>
								</span>
								<span>Card {i + 1}</span>
							</div>
							<h2 class="q" set:html={tex(c.q)} />
							<details class="ans">
								<summary class="mono">
									<span class="show">Show answer</span>
									<span class="hide">Hide answer</span>
								</summary>
								<div class="body">
									{c.a && <p class="verdict" set:html={tex(splitAnswer(c.a)[0])} />}
									{splitAnswer(c.a)[1] && <p class="why" set:html={tex(splitAnswer(c.a)[1])} />}
									{c.steps && (
										<ol class="steps">
											{c.steps.map((s) => (
												<li set:html={tex(s)} />
											))}
										</ol>
									)}
								</div>
							</details>
							<p class="keys mono">Arrow keys move between cards. Space shows the answer.</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</BaseLayout>

<script>
	const deck = document.querySelector<HTMLElement>("[data-deck]")!;
	const cards = [...deck.querySelectorAll<HTMLElement>("[data-card]")];
	const ticks = [...deck.querySelectorAll<HTMLButtonElement>("[data-jump]")];
	const count = deck.querySelector<HTMLElement>("[data-count]")!;
	const n = cards.length;

	let pos = 0;

	const fromHash = () => {
		const m = location.hash.match(/^#card-(\d+)$/);
		const i = m ? Number(m[1]) - 1 : -1;
		return i >= 0 && i < n ? i : 0;
	};

	// caps each picture at a little over twice its drawn size so small circuits don't balloon
	deck.querySelectorAll<SVGSVGElement>(".pic svg").forEach((svg) => {
		const vb = svg.viewBox.baseVal;
		if (!vb || !vb.width) return;
		svg.style.maxWidth = `${vb.width * 2.2}px`;
		svg.style.maxHeight = `${vb.height * 2.2}px`;
	});

	function show(p: number) {
		pos = (p + n) % n;
		cards.forEach((c, i) => {
			c.hidden = i !== pos;
			if (i !== pos) c.querySelector("details")!.open = false;
		});
		ticks.forEach((t, i) => t.classList.toggle("on", i === pos));
		count.textContent = `${pos + 1} of ${n}`;
		history.replaceState(null, "", `#card-${pos + 1}`);
	}

	deck.classList.add("js");
	show(fromHash());

	deck.querySelector("[data-prev]")!.addEventListener("click", () => show(pos - 1));
	deck.querySelector("[data-next]")!.addEventListener("click", () => show(pos + 1));
	ticks.forEach((t) => t.addEventListener("click", () => show(Number(t.dataset.jump))));

	document.addEventListener("keydown", (e) => {
		if (e.altKey || e.ctrlKey || e.metaKey) return;
		const tag = (e.target as HTMLElement).tagName;
		if (e.key === "ArrowRight") show(pos + 1);
		else if (e.key === "ArrowLeft") show(pos - 1);
		else if (e.key === " " && tag !== "BUTTON" && tag !== "SUMMARY") {
			e.preventDefault();
			const d = cards[pos].querySelector("details")!;
			d.open = !d.open;
		}
	});
</script>

<style>
	.app {
		--g: #00a86b;
		--ink: #1e293b;
		--paper: #fafafa;
		--mute: rgba(0, 168, 107, 0.7);
		--line: rgba(0, 168, 107, 0.3);
		--s0: #00a86b;
		--s1: #6b3fa0;
		--s2: #c2410c;
		--s3: #2563eb;
		--s4: #b91c1c;
		--s5: #1e293b;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 24px 16px;
		color: var(--ink);
		display: flex;
		flex-direction: column;
	}
	.app.js {
		height: 100vh;
		height: 100dvh;
	}
	.mono {
		font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 12px;
	}

	.top {
		padding-top: 14px;
	}
	.toprow {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 6px 16px;
		border-top: 2px solid var(--g);
		padding: 8px 0;
	}
	.name {
		color: var(--g);
		font-size: 12px;
		font-weight: 500;
	}
	.rule {
		height: 6px;
		background: var(--g);
	}

	.titlebar {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 10px 24px;
		margin-top: 14px;
	}
	.kicker {
		color: var(--mute);
		margin: 0;
		font-size: 11px;
	}
	h1 {
		font-style: italic;
		font-weight: 700;
		color: var(--g);
		font-size: clamp(26px, 3vw, 34px);
		line-height: 1.1;
		margin: 2px 0;
	}
	.lede {
		margin: 0;
		font-size: 15px;
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 10px;
	}
	.bar,
	.strip {
		visibility: hidden;
	}
	.app.js .bar,
	.app.js .strip {
		visibility: visible;
	}
	.count {
		color: var(--mute);
		margin-right: 6px;
	}
	.btn {
		font-family: ui-monospace, Menlo, Consolas, monospace;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 12px;
		padding: 6px 12px;
		border: 1px solid var(--g);
		background: var(--g);
		color: #fff;
		cursor: pointer;
	}
	.btn:hover {
		filter: brightness(0.9);
	}

	.strip {
		display: flex;
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
		gap: 2px;
	}
	.strip li {
		flex: 1 1 0;
		min-width: 0;
	}
	.tick {
		display: block;
		width: 100%;
		height: 10px;
		border: 0;
		padding: 0;
		cursor: pointer;
		background: var(--sc);
		opacity: 0.3;
	}
	.tick.on {
		opacity: 1;
		height: 16px;
		margin-top: -6px;
	}
	.tick:hover {
		opacity: 0.7;
	}
	.s0 {
		--sc: var(--s0);
	}
	.s1 {
		--sc: var(--s1);
	}
	.s2 {
		--sc: var(--s2);
	}
	.s3 {
		--sc: var(--s3);
	}
	.s4 {
		--sc: var(--s4);
	}
	.s5 {
		--sc: var(--s5);
	}

	.stage {
		margin-top: 14px;
	}
	.app.js .stage {
		flex: 1;
		min-height: 0;
	}
	.card {
		background: #fff;
		border: 1px solid var(--line);
		padding: 14px;
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(320px, 1fr);
		gap: 18px;
		height: min(82vh, 760px);
		margin-bottom: 16px;
	}
	.app.js .card {
		height: 100%;
		margin: 0;
	}
	.card[hidden] {
		display: none;
	}
	.pic {
		position: relative;
		margin: 0;
		min-height: 0;
		border: 1px dashed var(--line);
		background: var(--paper);
	}
	.side {
		display: flex;
		flex-direction: column;
		min-height: 0;
		overflow-y: auto;
		padding: 2px 4px 0 0;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 6px 12px;
		color: var(--mute);
	}
	.tags {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 1px 8px;
		font-size: 11px;
		letter-spacing: 0.08em;
		line-height: 1.6;
	}
	.chip {
		border: 1px solid var(--sc);
		color: var(--ink);
		background: var(--paper);
	}
	.chip::before {
		content: "";
		width: 8px;
		height: 8px;
		background: var(--sc);
		display: inline-block;
	}
	.q {
		font-style: italic;
		font-weight: 700;
		color: var(--g);
		font-size: clamp(21px, 2vw, 27px);
		line-height: 1.25;
		margin: 18px 0 0;
	}
	.ans {
		margin-top: 20px;
		text-align: center;
	}
	.ans summary {
		display: inline-block;
		cursor: pointer;
		padding: 8px 18px;
		border: 1px solid var(--g);
		color: var(--g);
		list-style: none;
	}
	.ans summary::-webkit-details-marker {
		display: none;
	}
	.ans[open] summary {
		background: rgba(0, 168, 107, 0.12);
	}
	.ans .hide,
	.ans[open] .show {
		display: none;
	}
	.ans[open] .hide {
		display: inline;
	}
	.ans .body {
		text-align: left;
		margin-top: 16px;
		padding: 14px 18px;
		background: rgba(0, 168, 107, 0.06);
		border-left: 4px solid var(--g);
		font-size: 18px;
		line-height: 1.5;
	}
	.ans p {
		margin: 0;
	}
	.ans .verdict {
		font-size: 22px;
		font-weight: 700;
		line-height: 1.3;
	}
	.ans .why {
		margin-top: 8px;
		font-size: 17px;
	}
	.ans .why :global(a) {
		color: var(--g);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.ans :global(.katex-display) {
		margin: 10px 0;
	}
	.steps {
		margin: 0;
		padding-left: 1.4em;
		list-style: decimal;
	}
	.steps li {
		margin: 4px 0;
	}
	.keys {
		display: none;
		color: var(--mute);
		margin: auto 0 0;
		padding-top: 16px;
		font-size: 10px;
	}
	.app.js .keys {
		display: block;
	}

	@media (max-width: 860px) {
		.app {
			padding: 0 16px 16px;
		}
		.app.js {
			height: auto;
		}
		.card,
		.app.js .card {
			grid-template-columns: minmax(0, 1fr);
			height: auto;
		}
		.pic {
			height: 52vh;
		}
		.side {
			overflow: visible;
		}
	}
</style>

<style is:global>
	.card .pic svg {
		position: absolute;
		inset: 0;
		margin: auto;
		width: calc(100% - 24px);
		height: calc(100% - 24px);
		overflow: visible;
	}
	.card svg use {
		color: #1e293b;
	}
	.card svg .w {
		stroke: #1e293b;
		stroke-width: 2;
		fill: none;
	}
	.card svg .t {
		font: 13px "Work Sans", sans-serif;
		fill: #1e293b;
	}
	.card svg .s {
		font: 11.5px "Work Sans", sans-serif;
		fill: #64748b;
	}
	.card svg .b {
		font-weight: 650;
	}
	.card svg .gt {
		fill: #00a86b;
	}
	.card svg .sub {
		font-size: 0.75em;
	}
	.card svg .thin {
		stroke: #64748b;
		stroke-width: 1.3;
		fill: none;
	}
	.card svg .mf {
		fill: #64748b;
	}
	.card svg .dots {
		stroke: #64748b;
		stroke-width: 2;
		stroke-dasharray: 2 5;
		fill: none;
	}
	.card svg .dash {
		stroke: #64748b;
		stroke-width: 1.3;
		stroke-dasharray: 6 5;
		fill: none;
	}
	.card svg .meter {
		fill: #fafafa;
		stroke: #1e293b;
		stroke-width: 2;
	}
	.card svg .blk {
		fill: #eef2f0;
		stroke: #1e293b;
		stroke-width: 1.5;
	}
	.card svg .bigdot {
		fill: #00a86b;
	}
	.card svg .hl {
		fill: rgba(0, 168, 107, 0.14);
		stroke: #00a86b;
		stroke-width: 1.5;
	}
	.card svg .glow {
		stroke: #00a86b;
		stroke-opacity: 0.2;
		stroke-width: 12;
		stroke-linecap: round;
		stroke-linejoin: round;
		fill: none;
	}
	.card svg .march {
		stroke: #00a86b;
		stroke-width: 3;
		stroke-dasharray: 7 9;
		fill: none;
		animation: march 0.9s linear infinite;
	}
	.card svg .pt {
		fill: #fbe5d6;
		stroke: #1e293b;
		stroke-width: 1.5;
	}
	.card svg .nt {
		fill: #dce8fb;
		stroke: #1e293b;
		stroke-width: 1.5;
	}
	.card svg .ox {
		fill: #e2e8f0;
		stroke: #64748b;
		stroke-width: 1.2;
	}
	.card svg .metal {
		fill: #94a3b8;
		stroke: #1e293b;
		stroke-width: 1.5;
	}
	.card svg .el {
		fill: #1e293b;
	}
	.card svg .hole {
		fill: #fff;
		stroke: #1e293b;
		stroke-width: 1.5;
	}
	.card svg .atom {
		fill: #fff;
		stroke: #1e293b;
		stroke-width: 1.5;
	}
	.card svg .atom.odd {
		fill: rgba(0, 168, 107, 0.14);
		stroke: #00a86b;
	}
	.card svg .bond {
		stroke: #94a3b8;
		stroke-width: 1.5;
	}
	.card svg .legend {
		fill: #fff;
		stroke: rgba(0, 168, 107, 0.45);
		stroke-width: 1;
	}
	.card svg .dep {
		fill: rgba(255, 255, 255, 0.75);
		stroke: #64748b;
		stroke-width: 1.2;
		stroke-dasharray: 4 3;
	}
	.card svg .ion {
		fill: #fff;
		stroke: #1e293b;
		stroke-width: 1.2;
	}
	.card svg .plus {
		font: 700 13px "Work Sans", sans-serif;
		fill: #fff;
	}
	.card svg .grid {
		stroke: #e2e8f0;
		stroke-width: 1;
	}
	.card svg .garrow {
		stroke: #00a86b;
		stroke-width: 2;
		fill: none;
	}
	.card svg .gfill {
		fill: #00a86b;
	}
	.card svg .wave-a {
		stroke: #64748b;
		stroke-width: 2.5;
		fill: none;
	}
	.card svg .wave-b {
		stroke: #1e293b;
		stroke-width: 2.5;
		fill: none;
	}
	.card svg .wave-blue {
		stroke: #2563eb;
		stroke-width: 2;
		fill: none;
	}
	.card svg .wave-ir {
		stroke: #b91c1c;
		stroke-width: 2;
		fill: none;
	}
	@keyframes march {
		to {
			stroke-dashoffset: -16;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card svg .march {
			animation: none;
		}
	}
</style>
