---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LogbookHeader from "../../../components/LogbookHeader.astro";
import HomeButton from "../../../components/HomeButton.astro";
import { logbooks, type Logbook } from "../../../data/logbooks";
import { gapNotes, gapKinds, type GapKind } from "../../../data/logbookGaps";
import EntryThumbs from "../../../components/EntryThumbs.astro";
import { entryImages } from "../../../lib/entryImages";
import { inlineCode } from "../../../lib/inlineCode";

export async function getStaticPaths() {
	return logbooks.map((logbook) => ({
		params: { project: logbook.slug },
		props: { logbook },
	}));
}

interface Props {
	logbook: Logbook;
}

const { project } = Astro.params;
const { logbook } = Astro.props;

const entries = await getCollection("logbook", (entry) => {
	const inProject = entry.id.startsWith(`${project}/`);
	const visible = import.meta.env.PROD ? !entry.data.draft : true;
	return inProject && visible;
});

entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtDate = (d: Date) =>
	d.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
		timeZone: "UTC",
	});
const fmtMonth = (d: Date) =>
	d.toLocaleDateString("en-US", { year: "numeric", month: "long", timeZone: "UTC" });

const DAY = 86400000;
const GAP_DAYS = 14;
const fmtShort = (t: number) =>
	new Date(t).toLocaleDateString("en-US", {
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});

// a gap hangs under the entry that ended it, a shipped marker above the last entry
type Gap = { from: number; to: number; days: number; kind?: GapKind; note?: string };
const gapEnding = new Map<string, Gap>();
const oldestFirst = [...entries].reverse();
for (let i = 1; i < oldestFirst.length; i++) {
	const from = oldestFirst[i - 1].data.date.getTime();
	const to = oldestFirst[i].data.date.getTime();
	const days = Math.round((to - from) / DAY);
	if (days >= GAP_DAYS) {
		const note = gapNotes.find(
			(n) => n.project === project && n.from === new Date(from).toISOString().slice(0, 10),
		);
		gapEnding.set(oldestFirst[i].id, { from, to, days, kind: note?.kind, note: note?.note });
	}
}
const lastEntryId = oldestFirst.length ? oldestFirst[oldestFirst.length - 1].id : null;

type Entry = (typeof entries)[number];
type TimelineItem =
	| { kind: "month"; label: string }
	| { kind: "entry"; entry: Entry; gap?: Gap; shipped: boolean };

const timeline: TimelineItem[] = [];
let lastLabel: string | null = null;
for (const entry of entries) {
	const label = fmtMonth(entry.data.date);
	if (label !== lastLabel) {
		timeline.push({ kind: "month", label });
		lastLabel = label;
	}
	timeline.push({
		kind: "entry",
		entry,
		gap: gapEnding.get(entry.id),
		shipped: logbook.status === "shipped" && entry.id === lastEntryId,
	});
}

const slugFromId = (id: string) => id.split("/").slice(1).join("/");
---

<BaseLayout
	title={`${logbook.title} | Logbook | Amjad Yaghi`}
	description={logbook.blurb}
>
	<LogbookHeader />

	<main
		data-aos="fade-up"
		data-aos-duration="2000"
		class="px-8 2xl:max-w-7xl mx-auto my-16"
	>
		<div class="text-center">
			<p class="text-xs font-mono uppercase tracking-widest text-secondary/70">
				Logbook
			</p>
			<h1 class="mt-4 text-4xl lg:text-6xl font-bold italic text-secondary">
				{logbook.title}
			</h1>
			<p
				class="my-4 text-slate-800 max-w-2xl mx-auto leading-relaxed"
			>
				{logbook.blurb}
			</p>
			<p class="text-xs font-mono uppercase tracking-wider text-secondary/70">
				{entries.length}
				{entries.length === 1 ? "entry" : "entries"}
			</p>
		</div>

		{
			entries.length === 0 ? (
				<p class="mt-24 text-center text-secondary/70 italic">
					No entries yet. Check back soon.
				</p>
			) : (
				<div class="mt-24 max-w-3xl mx-auto relative">
					<div
						class="absolute left-3 top-3 bottom-3 w-px bg-secondary/30 pointer-events-none"
						aria-hidden="true"
					/>
					<ol class="list-none">
						{timeline.map((item, i) =>
							item.kind === "month" ? (
								<li class="relative pl-12 mt-12 first:mt-0 mb-8">
									<span
										class="absolute left-3 top-1/2 -translate-x-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-secondary ring-4 ring-primary"
										aria-hidden="true"
									/>
									<span class="inline-block bg-primary px-3 py-1 border border-secondary/40 text-xs font-mono uppercase tracking-widest text-secondary">
										{item.label}
									</span>
								</li>
							) : (
								<>
								{item.shipped && (
									<li class="relative pl-12 mb-8">
										<div class="marker shipped">
											<span class="t">Shipped</span>
											<span class="range">No more entries for now!</span>
										</div>
									</li>
								)}
								<li class="entry-item relative pl-12 mb-12 last:mb-0">
									<span
										class="absolute left-3 top-2 -translate-x-1/2 w-3 h-3 rounded-full bg-secondary ring-4 ring-primary"
										aria-hidden="true"
									/>
									<a
										href={`/logbook/${project}/${slugFromId(item.entry.id)}`}
										class="group block"
									>
										<p class="text-xs font-mono text-secondary/70 tracking-wider">
											<time
												datetime={item.entry.data.date
													.toISOString()
													.slice(0, 10)}
											>
												{fmtDate(item.entry.data.date)}
											</time>
											{item.entry.data.draft && (
												<span class="ml-3 px-2 py-0.5 bg-secondary/20 text-secondary uppercase">
													draft
												</span>
											)}
										</p>
										<h2 class="text-2xl sm:text-3xl font-bold italic text-secondary mt-2 group-hover:underline underline-offset-4">
											{item.entry.data.title}
										</h2>
										<p
											class="text-base text-slate-800 mt-3 leading-relaxed"
											set:html={inlineCode(item.entry.data.summary)}
										/>
										<EntryThumbs images={entryImages(item.entry.body)} />
										{item.entry.data.tags &&
											item.entry.data.tags.length > 0 && (
												<ul class="flex flex-wrap gap-2 mt-4" role="list">
													{item.entry.data.tags.map((tag) => (
														<li class="text-xs font-mono text-secondary/70 px-2 py-0.5 border border-secondary/30">
															{tag}
														</li>
													))}
												</ul>
											)}
									</a>
								</li>
								{item.gap && (
									<li class="relative pl-12 mb-12">
										<div class={`marker gap ${item.gap.kind ?? "plain"}`}>
											{item.gap.kind ? (
												<>
													<div class="gl">
														<b>{gapKinds[item.gap.kind].label}</b>
													</div>
													<p class="quote">
														{item.gap.note ?? gapKinds[item.gap.kind].note}
													</p>
												</>
											) : (
												<div class="gl">
													<span>{item.gap.days} days since the last entry for this project</span>
												</div>
											)}
											<div class="range">
												{fmtShort(item.gap.from)} to {fmtShort(item.gap.to)},{" "}
												{new Date(item.gap.to).getUTCFullYear()}
											</div>
										</div>
									</li>
								)}
								</>
							)
						)}
					</ol>
				</div>
			)
		}

		<div class="mt-24 flex justify-center">
			<HomeButton />
		</div>
	</main>

	<footer class="mt-12 p-8 flex flex-col gap-2 2xl:max-w-7xl mx-auto mb-16">
		<div class="h-1.5 bg-secondary" data-aos="fade-up" data-aos-duration="2000">
		</div>
		<div class="h-3 bg-secondary" data-aos="fade-up" data-aos-duration="2500">
		</div>
		<div
			class="h-6 bg-secondary flex items-end p-4"
			data-aos="fade-up"
			data-aos-duration="3000"
		>
		</div>
	</footer>
</BaseLayout>

<style>
	.marker {
		font-family: inherit;
		color: #1e293b;
	}
	.marker .gl {
		font-family: ui-monospace, Menlo, Consolas, monospace;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 12px;
	}
	.marker .range {
		margin-top: 4px;
		color: rgba(0, 168, 107, 0.7);
		font-family: ui-monospace, Menlo, Consolas, monospace;
		font-size: 12px;
		letter-spacing: 0.04em;
	}
	.marker .quote {
		font-style: italic;
		margin: 6px 0 0;
	}
	.marker.gap {
		border: 1px dashed rgba(0, 168, 107, 0.7);
		padding: 10px 12px;
		background: repeating-linear-gradient(
			135deg,
			transparent 0 7px,
			rgba(30, 41, 59, 0.04) 7px 8px
		);
	}
	.marker.gap.plain {
		padding: 6px 12px;
		background: none;
	}
	.marker.gap.plain .gl {
		text-transform: none;
		letter-spacing: 0.02em;
		font-size: 13px;
	}
	.marker.gap.lost {
		border: 2px dashed #1e293b;
		padding: 14px;
	}
	.marker.gap.lost .gl b {
		font-weight: 700;
		letter-spacing: 0.12em;
		font-size: 13px;
	}
	.marker.gap.paused {
		border: 3px double #8a6d1a;
		padding: 12px 14px;
		background: linear-gradient(
			180deg,
			rgba(138, 109, 26, 0.1),
			rgba(138, 109, 26, 0) 70%
		);
	}
	.marker.gap.paused .gl b {
		font-weight: 700;
		letter-spacing: 0.14em;
		font-size: 13px;
		color: #8a6d1a;
	}
	.marker.shipped {
		border: 2px solid #1e293b;
		padding: 8px 12px;
		display: flex;
		flex-wrap: wrap;
		gap: 6px 12px;
		align-items: center;
	}
	.marker.shipped .t {
		font-family: ui-monospace, Menlo, Consolas, monospace;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 12px;
	}
	.marker.shipped .range {
		margin: 0;
	}
</style>
