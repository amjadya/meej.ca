---
// side view of a full badminton court with two shots flown across it, to scale, played back in real time.
// equations of motion as in the badminton-bot repo (src/core/birdie_dynamics.cpp): dv/dt = -g y_hat - alpha |v| v,
// rk4 at 1 ms, stopped at the floor like integrate_to_height, alpha 0.215 per m and g 9.81 (config/ekf.yaml).
// both start 1 m inside the far baseline. overhead clear: 43.1 m/s at 40 degrees from 2.6 m (the E12 clear;
// clears measure 42 to 51 m/s). serve: 50 m/s at 45 degrees from 1.1 m, under the 1.15 m serve limit, picked
// to land about where the clear does.
import Birdie from "./Birdie.astro";
import CourtAxes from "./CourtAxes.astro";

const uid = Math.random().toString(36).slice(2, 8);
const G = 9.81;
const ALPHA = 0.215;
const DT = 0.001;
const len = 13.4;
const back = 2.5;
const top = 8;
const W = 680;
const left = 62;
const floorY = 336;
const s = (W - left - 14) / (len + 2 * back);
const px = (x: number) => left + (x + back) * s;
const py = (h: number) => floorY - h * s;
const f1 = (v: number) => v.toFixed(1);

type S = [number, number, number, number];
const deriv = ([, , vx, vy]: S): S => {
	const sp = Math.hypot(vx, vy);
	return [vx, vy, -ALPHA * sp * vx, -G - ALPHA * sp * vy];
};
const rk4 = (st: S, h: number): S => {
	const k1 = deriv(st);
	const k2 = deriv(st.map((v, i) => v + (h / 2) * k1[i]) as S);
	const k3 = deriv(st.map((v, i) => v + (h / 2) * k2[i]) as S);
	const k4 = deriv(st.map((v, i) => v + h * k3[i]) as S);
	return st.map((v, i) => v + (h / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i])) as S;
};

// x along the court from the robot's baseline, h height above the floor; each shot flies toward the robot
const fly = (v0: number, deg: number, h0: number) => {
	const a = (deg * Math.PI) / 180;
	let st: S = [len - 1, h0, -v0 * Math.cos(a), v0 * Math.sin(a)];
	let t = 0;
	const pts: number[][] = [];
	for (let n = 0; ; n++) {
		if (n % 10 === 0) pts.push([+t.toFixed(3), +f1(px(st[0])), +f1(py(st[1])), +st[2].toFixed(2), +st[3].toFixed(2)]);
		const nx = rk4(st, DT);
		if (nx[1] <= 0) {
			const frac = st[1] / (st[1] - nx[1]);
			t += frac * DT;
			pts.push([+t.toFixed(3), +f1(px(st[0] + frac * (nx[0] - st[0]))), +f1(py(0)), +nx[2].toFixed(2), +nx[3].toFixed(2)]);
			return pts;
		}
		st = nx;
		t += DT;
	}
};
const shots = [
	{ name: "overhead clear", h0: 2.6, pts: fly(43.1, 40, 2.6), cls: "a" },
	{ name: "serve", h0: 1.1, pts: fly(50, 45, 1.1), cls: "b" },
].map((sh) => {
	const apex = sh.pts.reduce((m, p) => (p[2] < m[2] ? p : m));
	return { ...sh, apex, apexH: (floorY - apex[2]) / s, end: sh.pts[sh.pts.length - 1][0], path: sh.pts.map((p, i) => `${i ? "L" : "M"}${p[1]} ${p[2]}`).join("") };
});
const net = 1.55;
const ticks = Array.from({ length: top + 1 }, (_, i) => i);
const dimY = floorY + 48;
const arrow = (x1: number, x2: number) =>
	`M${x1} ${dimY}H${x2}M${x1 + 6} ${dimY - 4}L${x1} ${dimY}L${x1 + 6} ${dimY + 4}M${x2 - 6} ${dimY - 4}L${x2} ${dimY}L${x2 - 6} ${dimY + 4}`;
const label = shots.map((sh) => `${sh.name} from ${sh.h0} m, peaking at ${sh.apexH.toFixed(1)} m and landing after ${sh.end.toFixed(2)} s`).join("; ");
---

<div class="csv not-prose" data-csv data-shots={JSON.stringify(shots.map((sh) => sh.pts))}>
	<div class="key">
		{shots.map((sh) => (
			<span><i class={sh.cls}></i>{sh.name}, hit at {sh.h0} m</span>
		))}
	</div>
	<svg viewBox={`0 0 ${W} 452`} role="img" aria-label={`A side view of a badminton court drawn to scale, 13.4 m long with the net in the middle, and 2.5 m of floor behind each baseline. Two shots start 1 m inside the right baseline and land near the left one: ${label}.`}>
		<rect x={px(-back)} y={py(top)} width={back * s} height={top * s} class="zone"></rect>
		<rect x={px(len)} y={py(top)} width={back * s} height={top * s} class="zone"></rect>

		<line x1={left - 10} y1={py(0)} x2={left - 10} y2={py(top)} class="axis"></line>
		{ticks.map((i) => (
			<g>
				<line x1={left - 15} y1={py(i)} x2={left - 10} y2={py(i)} class="axis"></line>
				<text x={left - 19} y={py(i) + 4} class="sm" text-anchor="end">{i}</text>
			</g>
		))}
		<text x="14" y={py(top / 2)} class="sm" text-anchor="middle" transform={`rotate(-90 14 ${py(top / 2)})`}>height (m)</text>

		<line x1={px(-back)} y1={floorY} x2={px(len + back)} y2={floorY} class="floor"></line>
		<CourtAxes x={px(0)} y={floorY} view="side" />
		<line x1={px(len)} y1={floorY} x2={px(len)} y2={floorY + 8} class="mark"></line>
		<text x={px(0)} y={floorY + 25} class="sm" text-anchor="middle">baseline</text>
		<text x={px(len)} y={floorY + 25} class="sm" text-anchor="middle">baseline</text>
		<line x1={px(len / 2)} y1={floorY} x2={px(len / 2)} y2={py(net)} class="net"></line>
		<text x={px(len / 2)} y={py(net) - 10} class="lbl" text-anchor="middle">net</text>

		<path d={arrow(px(-back), px(0))} class="dim"></path>
		<path d={arrow(px(0), px(len))} class="dim"></path>
		<path d={arrow(px(len), px(len + back))} class="dim"></path>
		<text x={px(-back / 2)} y={dimY + 19} class="sm" text-anchor="middle">{back} m</text>
		<text x={px(len / 2)} y={dimY + 19} class="sm" text-anchor="middle">13.4 m</text>
		<text x={px(len + back / 2)} y={dimY + 19} class="sm" text-anchor="middle">{back} m</text>

		{shots.map((sh, k) => (
			<g>
				<path d={sh.path} class={`ghost ${sh.cls}`}></path>
				<path d="" class={`trail ${sh.cls}`} data-trail={k}></path>
				<text x={sh.apex[1]} y={sh.apex[2] + (k ? 28 : -16)} class={`lbl ${sh.cls}`} text-anchor="middle">{sh.apexH.toFixed(1)} m</text>
				<g data-birdie={k} transform={`translate(${sh.pts[0][1]} ${sh.pts[0][2]})`}>
					<Birdie uid={`c${uid}${k}`} transform="scale(0.3)" />
				</g>
			</g>
		))}
		<text x={px(len / 2)} y="446" class="clock" text-anchor="middle" data-clock>t = 0.00 s</text>
	</svg>
</div>

<script>
	// plays both shots along their paths in real time, holds on the landings, then starts again
	document.querySelectorAll<HTMLElement>("[data-csv]").forEach((root) => {
		const shots: number[][][] = JSON.parse(root.dataset.shots!);
		const clock = root.querySelector("[data-clock]")!;
		const end = Math.max(...shots.map((p) => p[p.length - 1][0]));
		const hold = 1.2;
		const show = (tt: number) => {
			shots.forEach((pts, k) => {
				let i = 0;
				while (i < pts.length - 1 && pts[i + 1][0] <= tt) i++;
				const p = pts[i];
				const rot = (Math.atan2(-p[3], -p[4]) * 180) / Math.PI;
				root.querySelector(`[data-birdie="${k}"]`)!.setAttribute("transform", `translate(${p[1]} ${p[2]}) rotate(${rot.toFixed(1)})`);
				root.querySelector(`[data-trail="${k}"]`)!.setAttribute("d", pts.slice(0, i + 1).map((q, j) => `${j ? "L" : "M"}${q[1]} ${q[2]}`).join(""));
			});
			clock.textContent = `t = ${tt.toFixed(2)} s`;
		};
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			show(end);
			return;
		}
		let t0: number | null = null;
		const frame = (now: number) => {
			if (t0 === null) t0 = now;
			const tt = ((now - t0) / 1000) % (end + hold);
			show(Math.min(tt, end));
			requestAnimationFrame(frame);
		};
		requestAnimationFrame(frame);
	});
</script>

<style is:global>
	.csv {
		background: #fff;
		border: 1px solid rgba(0, 168, 107, 0.3);
		padding: 12px 16px 14px;
	}
	.csv svg {
		display: block;
		width: 100%;
		height: auto;
		max-width: 680px;
		margin: 0 auto;
	}
	.csv .zone {
		fill: #f1f5f9;
	}
	.csv .floor {
		stroke: #334155;
		stroke-width: 2;
	}
	.csv .mark,
	.csv .axis {
		stroke: #334155;
		stroke-width: 1.5;
	}
	.csv .net {
		stroke: #334155;
		stroke-width: 3;
	}
	.csv .dim {
		fill: none;
		stroke: #64748b;
		stroke-width: 1.2;
	}
	.csv .guide {
		stroke-width: 1.2;
		stroke-dasharray: 3 3;
	}
	.csv .ghost {
		fill: none;
		stroke-width: 1.5;
		stroke-dasharray: 4 6;
		opacity: 0.45;
	}
	.csv .trail {
		fill: none;
		stroke-width: 2.6;
		stroke-linecap: round;
	}
	.csv .a.ghost,
	.csv .a.trail,
	.csv .a.guide {
		stroke: #d97706;
	}
	.csv .b.ghost,
	.csv .b.trail,
	.csv .b.guide {
		stroke: #7c3aed;
	}
	.csv text.a {
		fill: #b45309;
	}
	.csv text.b {
		fill: #6d28d9;
	}
	/* the key sits above the drawing so it never covers a path or a label */
	.csv .key {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px 24px;
		margin-bottom: 4px;
		font: 13px "Work Sans", sans-serif;
		color: #475569;
	}
	.csv .key i {
		display: inline-block;
		width: 28px;
		height: 3px;
		margin-right: 8px;
		vertical-align: middle;
		border-radius: 2px;
	}
	.csv .key i.a {
		background: #d97706;
	}
	.csv .key i.b {
		background: #7c3aed;
	}
	.csv .lbl {
		font: 15px "Work Sans", sans-serif;
		fill: #475569;
	}
	.csv .sm {
		font: 13px "Work Sans", sans-serif;
		fill: #475569;
	}
	.csv .clock {
		font: 600 15px ui-monospace, Menlo, Consolas, monospace;
		fill: #475569;
	}
	@media (max-width: 560px) {
		.csv {
			margin-left: -32px;
			margin-right: -32px;
			border-left: 0;
			border-right: 0;
			padding: 10px 12px 12px;
		}
		.csv .lbl {
			font-size: 19px;
		}
		.csv .sm {
			font-size: 17px;
		}
	}
</style>
