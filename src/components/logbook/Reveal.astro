---
// click to reveal answer card, like the back of a flash card, or a note when given a label.
const { label } = Astro.props as { label?: string };
---

<details class={label ? "lbreveal lbnote not-prose" : "lbreveal not-prose"}>
	<summary>{label ?? "Show answer"}</summary>
	<div class="ans"><slot /></div>
</details>

<style is:global>
	.lbreveal {
		margin: 1.25rem 0 1.75rem;
		border: 1px solid rgba(0, 168, 107, 0.3);
		border-left: 3px solid #00a86b;
		background: rgba(0, 168, 107, 0.04);
	}
	.lbreveal summary {
		cursor: pointer;
		padding: 10px 14px;
		font: 600 13px ui-monospace, Menlo, Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #00a86b;
		list-style: none;
		user-select: none;
	}
	.lbreveal summary::-webkit-details-marker {
		display: none;
	}
	.lbreveal summary::before {
		content: "+";
		display: inline-block;
		width: 1.2em;
	}
	.lbreveal[open] summary::before {
		content: "\2212";
	}
	.lbreveal[open] summary {
		border-bottom: 1px dashed rgba(0, 168, 107, 0.3);
	}
	.lbreveal .ans {
		padding: 12px 14px 14px;
		font-size: 18px;
		line-height: 1.6;
		color: #1e293b;
	}
	.lbreveal .ans p {
		margin: 0;
	}
	.lbnote summary {
		font: italic 500 17px "Work Sans", sans-serif;
		letter-spacing: 0;
		text-transform: none;
	}
	.lbnote .ans p + p,
	.lbnote .ans p + figure,
	.lbnote .ans figure + p {
		margin-top: 0.9em;
	}
</style>
