---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	images: { src: ImageMetadata; alt: string }[];
}

const { title, images } = Astro.props;
---

<div class="mb-8">
  <header>
    <h1
      id={title}
      class="text-4xl lg:text-6xl font-bold mb-4 text-center text-secondary"
      data-aos="fade-up"
      data-aos-duration="2000"
    >
      {title}
    </h1>
  </header>
  <div
    class="mt-4 mb-4 h-0.5 bg-secondary"
    data-aos="fade-up"
    data-aos-duration="2500"
  >
  </div>
  <section
    class="flex flex-col sm:flex-row gap-4 w-full"
    data-aos="fade-up"
    data-aos-duration="2500"
  >
    {
      images?.map(({ src, alt }) => (
        <div class="max-w-full flex-1">
          <Picture
            src={src}
            alt={alt}
            formats={["avif", "webp"]}
            widths={[400, 800, 1200]}
            sizes="(min-width: 640px) 33vw, 100vw"
            class="object-cover w-full h-full"
            loading="lazy"
          />
        </div>
      ))
    }
  </section>
</div>
