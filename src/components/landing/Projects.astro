---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { logbooks } from "../../data/logbooks";
import zipline from "../../assets/robot_on_zipline.jpg";
import teamPhoto from "../../assets/UBCRocket_TeamPhoto.JPG";

const projects = await getCollection("project");

// still is the photo shown at rest, video is the clip that plays on hover
const media: Record<string, { still?: ImageMetadata; video?: string }> = {
	"autonomous-mario-kart-robot": {
		still: zipline,
		video: "/videos/robot1.mp4",
	},
	"projection-mapped-interactive-string": { video: "/videos/pluck with glove.mp4" },
	"cnn-letter-detecting-ros-sim": { video: "/videos/CNN clue detecting robot.mp4" },
	"breaking-blood-clots-in-zero-g": { still: teamPhoto },
};

const rl = logbooks.find((l) => l.slug === "rl-arm-tracking")!;

const cards = [
	{
		key: "rl-arm-tracking",
		title: rl.title,
		description: rl.blurb,
		href: `/logbook/${rl.slug}`,
		still: undefined as ImageMetadata | undefined,
		video: "/videos/rl_tracking_demo.mp4",
		lead: true,
	},
	...projects
		.sort((a, b) => (a.data?.order ?? 0) - (b.data?.order ?? 0))
		.map((p) => ({
			key: p.data.slug,
			title: p.data.title,
			description: p.data.description,
			href: `/project/${p.data.slug}`,
			still: media[p.data.slug]?.still,
			video: media[p.data.slug]?.video,
			lead: false,
		})),
];
---

<section class="bg-primary">
	<div class="px-8 2xl:max-w-7xl mx-auto py-32">
		<div class="space-y-2">
			<div
				class="h-0.5 bg-secondary"
				data-aos="fade-up"
				data-aos-duration="1000"
			>
			</div>
			<h3
				class="text-secondary text-base font-medium"
				data-aos="fade-up"
				data-aos-duration="1500"
			>
				<span>Shipped</span>
				<span class="font-bold">work</span>
			</h3>
		</div>

		<ul class="showcase" role="list">
			{
				cards.map((c, index) => (
					<li
						class={index < 2 ? "lead" : ""}
						data-aos="fade-up"
						data-aos-duration="1500"
						data-aos-delay={(index < 2 ? index : (index - 2) % 3) * 150}
					>
						<a href={c.href} class="card">
							<div class="media">
								{c.still && <Image src={c.still} width={900} alt="" loading="lazy" />}
								{c.video && (
									<video
										src={c.still ? c.video : `${c.video}#t=0.5`}
										preload={c.still ? "none" : "metadata"}
										muted
										loop
										playsinline
									/>
								)}
								{c.video && <span class="play">hover to play</span>}
							</div>
							<p class="name">{c.title}</p>
							<p class={`desc${c.description.length > 90 ? " long" : ""}`}>
								{c.description}
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	// touch devices have no hover, so a tap plays and pauses the clip
	document.querySelectorAll<HTMLElement>(".showcase .card").forEach((card) => {
		const v = card.querySelector("video");
		if (!v) return;
		card.addEventListener("mouseenter", () => v.play().catch(() => {}));
		card.addEventListener("mouseleave", () => v.pause());
		card.addEventListener("click", (e) => {
			if (matchMedia("(hover: none)").matches) {
				e.preventDefault();
				card.classList.toggle("playing");
				if (card.classList.contains("playing")) v.play().catch(() => {});
				else v.pause();
			}
		});
	});
</script>

<style>
	.showcase {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 56px 32px;
		margin-top: 80px;
		list-style: none;
		padding: 0;
		color: #00a86b;
	}
	.showcase li {
		grid-column: span 2;
		min-width: 0;
	}
	.showcase .lead {
		grid-column: span 3;
	}
	.card {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #e5e7eb;
		border: 1px solid rgba(0, 168, 107, 0.4);
	}
	.lead .media {
		aspect-ratio: 16 / 9;
	}
	.media img,
	.media video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.media video {
		opacity: 0;
		transition: opacity 0.25s;
	}
	.media:not(:has(img)) video,
	.card:hover .media video,
	.card.playing .media video {
		opacity: 1;
	}
	.play {
		position: absolute;
		z-index: 2;
		background: #fafafa;
		border: 1px solid rgba(0, 168, 107, 0.5);
		color: #00a86b;
		font: 11px ui-monospace, monospace;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		padding: 2px 8px;
	}
	.play {
		right: 8px;
		bottom: 8px;
	}
	.card:hover .play {
		display: none;
	}
	.name {
		font: 12px ui-monospace, monospace;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.7;
		margin: 14px 0 0;
	}
	.desc {
		font-style: italic;
		font-weight: 700;
		font-size: 26px;
		line-height: 1.2;
		margin: 6px 0 0;
	}
	.desc.long {
		font-size: 18px;
		font-style: normal;
		font-weight: 500;
		line-height: 1.5;
	}
	.card:hover .desc {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	@media (max-width: 900px) {
		.showcase li,
		.showcase .lead {
			grid-column: span 3;
		}
		.lead .media {
			aspect-ratio: 4 / 3;
		}
	}
	@media (max-width: 560px) {
		.showcase li,
		.showcase .lead {
			grid-column: span 6;
		}
		.desc {
			font-size: 22px;
		}
	}
</style>
