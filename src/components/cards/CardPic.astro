---
// the picture on each card, picked by the card's pic key
import Channel from "./Channel.astro";

interface Props {
	pic: string;
}
const { pic } = Astro.props;

const mainFlow = "M430 30V520H306";
const mainChev: [number, number, number][] = [
	[430, 62, 90],
	[430, 326, 90],
	[430, 425, 90],
	[372, 520, 180],
];
const gatePath = "M114 170H213L230 200V240";
const mosLabel: Record<string, string> = {
	"mos-lowside":
		"A 12 V supply, a load, and an N-channel MOSFET below the load with its source to GND. The gate sits at 5 V and the threshold is 2 V. The highlighted path runs through the load, into the drain and out the source.",
	"mos-gate-path":
		"The same low-side MOSFET circuit with the gate at 5 V. The highlighted path runs from the gate pin into the gate and out the source to GND.",
	"mos-compare":
		"Two copies of the same low-side MOSFET circuit, each with a 2 V threshold. One gate sits at 2.3 V, the other at 10 V.",
};
// a 3 by 3 patch of the silicon lattice, every bond drawn with its two shared electrons
const LX = [70, 160, 250];
const LY = [60, 150, 240];
const bonds: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (const y of LY) {
	bonds.push({ x1: 20, y1: y, x2: 50, y2: y }, { x1: 270, y1: y, x2: 300, y2: y });
	bonds.push({ x1: 90, y1: y, x2: 140, y2: y }, { x1: 180, y1: y, x2: 230, y2: y });
}
for (const x of LX) {
	bonds.push({ x1: x, y1: 10, x2: x, y2: 40 }, { x1: x, y1: 260, x2: x, y2: 290 });
	bonds.push({ x1: x, y1: 80, x2: x, y2: 130 }, { x1: x, y1: 170, x2: x, y2: 220 });
}
const bondDots = (b: (typeof bonds)[number]) => {
	const mx = (b.x1 + b.x2) / 2;
	const my = (b.y1 + b.y2) / 2;
	return b.y1 === b.y2
		? [
				[mx - 7, my],
				[mx + 7, my],
			]
		: [
				[mx, my - 7],
				[mx, my + 7],
			];
};
// the electron in the boron card's short bond that is missing
const isMissing = (x: number, y: number) => x === 198 && y === 150;

const holesP = [
	[60, 70], [98, 80], [136, 68], [174, 78], [204, 70],
	[78, 108], [118, 112], [156, 102], [196, 112],
	[60, 146], [100, 142], [140, 150], [178, 144], [206, 150],
];

const q2Flow = "M114 380H340V520H306";
const q2Chev: [number, number, number][] = [
	[136, 380, 0],
	[300, 380, 0],
	[340, 496, 90],
];
---

{
	pic === "kvl-two" && (
		<svg viewBox="0 0 380 280" role="img" aria-label="A 24 V battery with two resistors in series. A voltmeter across the top resistor reads 15 V, and a second voltmeter across the bottom resistor reads an unknown value.">
			<path class="w" d="M80 40V110M80 150V250H220V210M220 150V120M220 60V40H80" />
			<use href="#bat-v" x="80" y="110" />
			<text class="t b" x="56" y="135" text-anchor="end">24 V</text>
			<text class="s" x="98" y="122">+</text>
			<use href="#res-v" x="220" y="60" />
			<use href="#res-v" x="220" y="150" />
			<path class="w" d="M220 50H310V77M310 107V164M310 196V230H220M310 135H220" />
			<circle class="meter" cx="310" cy="92" r="15" />
			<text class="t b" x="310" y="96.5" text-anchor="middle">V</text>
			<circle class="meter" cx="310" cy="180" r="15" />
			<text class="t b" x="310" y="184.5" text-anchor="middle">V</text>
			<text class="t b" x="334" y="97">15 V</text>
			<text class="t b gt" x="334" y="185">?</text>
			<use href="#dot" x="220" y="50" />
			<use href="#dot" x="220" y="135" />
			<use href="#dot" x="220" y="230" />
			<use href="#dot" x="310" y="135" />
		</svg>
	)
}

{
	(pic === "ohm" || pic === "ohm-power") && (
		<svg viewBox="0 0 320 170" role="img" aria-label={pic === "ohm" ? "A 10 ohm resistor with a voltmeter across it reading 2 V." : "A 10 ohm resistor with 2 V across it and 200 mA through it."}>
			<path class="w" d="M43.6 110H130M190 110H276.4" />
			<use href="#res-h" x="130" y="110" />
			<use href="#term" x="40" y="110" />
			<use href="#term" x="280" y="110" />
			<path class="w" d="M90 110V45H145M175 45H230V110" />
			<circle class="meter" cx="160" cy="45" r="15" />
			<text class="t b" x="160" y="49.5" text-anchor="middle">V</text>
			<text class="t b" x="160" y="20" text-anchor="middle">2 V</text>
			<use href="#dot" x="90" y="110" />
			<use href="#dot" x="230" y="110" />
			<text class="t b" x="160" y="140" text-anchor="middle">10 Ω</text>
			<path class="thin" d="M232 132H258" />
			<polygon class="mf" points="266,132 257,127.5 257,136.5" />
			<text class:list={["t b", pic === "ohm" && "gt"]} x="249" y="156" text-anchor="middle">
				{pic === "ohm" ? "?" : "200 mA"}
			</text>
		</svg>
	)
}

{
	pic === "series-amm" && (
		<svg viewBox="0 0 420 290" role="img" aria-label="A battery and three resistors in series. An ammeter between the first and second resistors reads 50 mA. A second ammeter after the third resistor reads an unknown value.">
			<path class="w" d="M50 60V120M50 160V260H340V205M340 175V150M340 90V60H280M220 60H200M170 60H150M90 60H50" />
			<use href="#bat-v" x="50" y="120" />
			<text class="s" x="68" y="132">+</text>
			<use href="#res-h" x="90" y="60" />
			<circle class="meter" cx="185" cy="60" r="15" />
			<text class="t b" x="185" y="64.5" text-anchor="middle">A</text>
			<text class="t b" x="185" y="32" text-anchor="middle">50 mA</text>
			<use href="#res-h" x="220" y="60" />
			<use href="#res-v" x="340" y="90" />
			<circle class="meter" cx="340" cy="190" r="15" />
			<text class="t b" x="340" y="194.5" text-anchor="middle">A</text>
			<text class="t b gt" x="364" y="195">?</text>
		</svg>
	)
}

{
	pic === "gnd-node" && (
		<svg viewBox="0 0 380 290" role="img" aria-label="A 24 V battery with two resistors in series: 15 V across the top one and 9 V across the bottom one. The battery's negative end is GND, 0 V. A dot marks the wire between the two resistors.">
			<path class="w" d="M80 40V110M80 150V250H220V210M220 150V120M220 60V40H80" />
			<use href="#bat-v" x="80" y="110" />
			<text class="t b" x="56" y="135" text-anchor="end">24 V</text>
			<text class="s" x="98" y="122">+</text>
			<use href="#res-v" x="220" y="60" />
			<use href="#res-v" x="220" y="150" />
			<path class="thin" d="M236 62H244V118H236M236 152H244V208H236" />
			<text class="s b" x="250" y="72">+</text>
			<text class="s b" x="250" y="118">−</text>
			<text class="s b" x="250" y="162">+</text>
			<text class="s b" x="250" y="208">−</text>
			<text class="t b" x="264" y="95">15 V across</text>
			<text class="t b" x="264" y="185">9 V across</text>
			<use href="#gnd" x="150" y="250" />
			<text class="s" x="166" y="276">GND (0 V)</text>
			<circle class="bigdot" cx="220" cy="135" r="6" />
			<text class="t b gt" x="204" y="140" text-anchor="end">?</text>
		</svg>
	)
}

{
	pic === "diode-against" && (
		<svg viewBox="0 0 380 290" role="img" aria-label="A battery, a resistor and a diode in one loop. The diode's triangle points against the direction of the highlighted current path.">
			<path class="glow" d="M70 120V50H320V250H70V160" />
			<path class="w" d="M70 50V120M70 160V250H320V170M320 130V50H230M170 50H70" />
			<use href="#bat-v" x="70" y="120" />
			<text class="s" x="88" y="132">+</text>
			<use href="#res-h" x="170" y="50" />
			<use href="#diode-d" transform="translate(320 170) scale(1 -1)" />
			<path class="march" d="M70 120V50H320V250H70V160" />
			<use href="#chev" transform="translate(120 50)" />
			<use href="#chev" transform="translate(320 92) rotate(90)" />
			<use href="#chev" transform="translate(320 214) rotate(90)" />
			<use href="#chev" transform="translate(200 250) rotate(180)" />
		</svg>
	)
}

{
	(pic === "led-basic" || pic === "led-sag") && (
		<svg viewBox="0 0 440 290" role="img" aria-label={pic === "led-basic" ? "A 5 V battery, a 150 ohm resistor and an LED pointing the right way. The LED drops 2 V." : "The same LED circuit with the battery sagged from 5 V to 4.4 V."}>
			<path class="w" d="M70 50V120M70 160V250H320V170M320 130V50H230M170 50H70" />
			<use href="#bat-v" x="70" y="120" />
			<text class="s" x="88" y="132">+</text>
			<text class="t b" x="48" y="145" text-anchor="end">
				{pic === "led-basic" ? "5 V" : "4.4 V"}
			</text>
			{pic === "led-sag" && (
				<text class="s" x="48" y="161" text-anchor="end">
					was 5 V
				</text>
			)}
			<use href="#res-h" x="170" y="50" />
			<text class="t b" x="200" y="30" text-anchor="middle">150 Ω</text>
			<use href="#led-d" x="320" y="130" />
			<text class="t b" x="350" y="155">drops 2 V</text>
			<path class="thin" d="M236 268H184" />
			<polygon class="mf" points="176,268 185,263.5 185,272.5" />
			<text class="t b gt" x="166" y="273" text-anchor="end">?</text>
		</svg>
	)
}

{
	pic === "led-reversed" && (
		<svg viewBox="0 0 440 290" role="img" aria-label="The same LED circuit with the 5 V battery flipped around, so it pushes the other way. The LED is rated for 5 V backwards.">
			<path class="w" d="M70 50V120M70 160V250H320V170M320 130V50H230M170 50H70" />
			<use href="#bat-v" transform="translate(70 160) scale(1 -1)" />
			<text class="s" x="88" y="158">+</text>
			<text class="t b" x="48" y="145" text-anchor="end">5 V</text>
			<text class="s" x="48" y="161" text-anchor="end">flipped</text>
			<use href="#res-h" x="170" y="50" />
			<text class="t b" x="200" y="30" text-anchor="middle">150 Ω</text>
			<use href="#led-d" x="320" y="130" />
			<text class="s b" x="350" y="146">rated 5 V</text>
			<text class="s b" x="350" y="161">backwards</text>
		</svg>
	)
}

{
	pic === "led-string" && (
		<svg viewBox="0 0 370 170" role="img" aria-label="Twelve LEDs in series, each dropping 1.6 V.">
			<use href="#term" x="20" y="70" />
			<path class="w" d="M23.6 70H40M80 70H100M140 70H160M200 70H210M250 70H260M300 70H336.4" />
			<use href="#led-r" x="40" y="70" />
			<use href="#led-r" x="100" y="70" />
			<use href="#led-r" x="160" y="70" />
			<path class="dots" d="M214 70H246" />
			<use href="#led-r" x="260" y="70" />
			<use href="#term" x="340" y="70" />
			<text class="s" x="230" y="44" text-anchor="middle">LED4 to 11</text>
			<text class="t b" x="60" y="100" text-anchor="middle">1.6 V</text>
			<text class="t b" x="120" y="100" text-anchor="middle">1.6 V</text>
			<text class="t b" x="180" y="100" text-anchor="middle">1.6 V</text>
			<text class="t b" x="280" y="100" text-anchor="middle">1.6 V</text>
			<path class="thin" d="M24 118V126H336V118" />
			<text class="t b gt" x="180" y="150" text-anchor="middle">whole string: ?</text>
		</svg>
	)
}

{
	(pic === "mos-lowside" || pic === "mos-gate-path" || pic === "mos-compare") && (
		<svg viewBox={pic === "mos-compare" ? "60 0 600 270" : "60 0 300 270"} role="img" aria-label={mosLabel[pic]}>
			{(pic === "mos-compare" ? ["2.3 V", "10 V"] : ["5 V"]).map((g, i) => (
				<g transform={`translate(${i * 300} 0)`}>
					{pic === "mos-lowside" && <path class="glow" d="M230 30V240" />}
					{pic === "mos-gate-path" && <path class="glow" d={gatePath} />}
					<text class="t b" x="230" y="20" text-anchor="middle">12 V</text>
					<path class="w" d="M212 28H248M230 28V60M230 120V140M230 200V240M113.6 170H202" />
					<use href="#res-v" x="230" y="60" />
					<text class="s" x="244" y="94">load</text>
					<use href="#nmos" x="202" y="170" />
					<use href="#gnd" x="230" y="240" />
					<use href="#term" x="110" y="170" />
					<text class="t b" x="110" y="150" text-anchor="middle">gate {g}</text>
					<text class="s" x="196" y="163" text-anchor="end">G</text>
					<text class="s" x="240" y="150">D</text>
					<text class="s" x="240" y="198">S</text>
					<text class="s b" x="256" y="174">threshold 2 V</text>
					{pic === "mos-lowside" && (
						<>
							<path class="march" d="M230 30V240" />
							<use href="#chev" transform="translate(230 44) rotate(90)" />
							<use href="#chev" transform="translate(230 132) rotate(90)" />
							<use href="#chev" transform="translate(230 224) rotate(90)" />
						</>
					)}
					{pic === "mos-gate-path" && (
						<>
							<path class="march" d={gatePath} />
							<use href="#chev" transform="translate(150 170)" />
							<use href="#chev" transform="translate(230 224) rotate(90)" />
						</>
					)}
				</g>
			))}
		</svg>
	)
}

{
	pic === "mos-vgs" && (
		<svg viewBox="0 0 320 220" role="img" aria-label="An N-channel MOSFET on its own. The gate is at 5 V, the source is at 4 V, and the threshold is 2 V.">
			<path class="w" d="M73.6 110H130M158 80V43.6M158 140V176.4" />
			<use href="#nmos" x="130" y="110" />
			<use href="#term" x="70" y="110" />
			<use href="#term" x="158" y="40" />
			<use href="#term" x="158" y="180" />
			<text class="t b" x="70" y="90" text-anchor="middle">gate 5 V</text>
			<text class="t b" x="172" y="44">drain</text>
			<text class="t b" x="172" y="184">source 4 V</text>
			<text class="s b" x="184" y="114">threshold 2 V</text>
		</svg>
	)
}

{
	(pic === "npn-base" || pic === "npn-gain") && (
		<svg viewBox="0 0 360 280" role="img" aria-label={pic === "npn-base" ? "An NPN transistor. A 5 V microcontroller pin feeds its base through a resistor, the emitter goes to GND, and the collector goes up through a load to 12 V. The highlighted path runs from the pin into the base and out the emitter to GND." : "The same NPN circuit with a 100 ohm load, a meter reading 100 microamps on the base wire, and the transistor labelled gain 100. The collector current is unknown."}>
			{pic === "npn-base" && <path class="glow" d="M44 170H213L228 185V240" />}
			<text class="t b" x="228" y="20" text-anchor="middle">12 V</text>
			<path class="w" d="M210 28H246M228 28V60M228 120V140M228 200V240M170 170H200" />
			<use href="#res-v" x="228" y="60" />
			<text class="s" x="242" y="94">{pic === "npn-base" ? "load" : "100 Ω load"}</text>
			<use href="#npn" x="200" y="170" />
			<use href="#gnd" x="228" y="240" />
			<text class="s" x="238" y="148">C</text>
			<text class="s" x="238" y="200">E</text>
			<use href="#term" x="40" y="170" />
			<text class="t b" x="40" y="150" text-anchor="middle">pin 5 V</text>
			<use href="#res-h" x="110" y="170" />
			{pic === "npn-base" ? (
				<path class="w" d="M43.6 170H110" />
			) : (
				<>
					<path class="w" d="M43.6 170H70M100 170H110" />
					<circle class="meter" cx="85" cy="170" r="15" />
					<text class="t b" x="85" y="174.5" text-anchor="middle">A</text>
					<text class="t b" x="85" y="206" text-anchor="middle">100 µA</text>
					<text class="s b" x="252" y="174">gain 100</text>
					<path class="thin" d="M206 62V100" />
					<polygon class="mf" points="206,108 201.5,99 210.5,99" />
					<text class="t b gt" x="194" y="90" text-anchor="end">?</text>
				</>
			)}
			{pic === "npn-base" && (
				<>
					<path class="march" d="M44 170H213L228 185V240" />
					<use href="#chev" transform="translate(84 170)" />
					<use href="#chev" transform="translate(228 224) rotate(90)" />
				</>
			)}
		</svg>
	)
}

{
	pic === "npn-low" && (
		<svg viewBox="0 0 320 220" role="img" aria-label="An NPN transistor with its base 0.3 V above its emitter. The highlighted path runs from collector to emitter.">
			<path class="glow" d="M158 44V176" />
			<path class="w" d="M73.6 110H130M158 80V43.6M158 140V176.4" />
			<use href="#npn" x="130" y="110" />
			<use href="#term" x="70" y="110" />
			<use href="#term" x="158" y="40" />
			<use href="#term" x="158" y="180" />
			<text class="t b" x="70" y="90" text-anchor="middle">base 0.3 V</text>
			<text class="t b" x="172" y="44">collector</text>
			<text class="t b" x="172" y="184">emitter 0 V</text>
			<path class="march" d="M158 44V176" />
			<use href="#chev" transform="translate(158 62) rotate(90)" />
			<use href="#chev" transform="translate(158 162) rotate(90)" />
		</svg>
	)
}

{
	(pic === "si-pure" || pic === "si-n" || pic === "si-p") && (
		<svg viewBox="0 0 510 300" role="img" aria-label={pic === "si-pure" ? "A patch of the silicon lattice. Each silicon atom bonds to four neighbours, and each bond holds two shared electrons." : pic === "si-n" ? "The same lattice with a phosphorus atom in the middle. Its four bonds are full, and one spare electron sits beside it." : "The same lattice with a boron atom in the middle. One of its bonds holds only one electron, leaving a hole."}>
			{bonds.map((b) => (
				<line class="bond" x1={b.x1} y1={b.y1} x2={b.x2} y2={b.y2} />
			))}
			{bonds.flatMap((b) =>
				bondDots(b).map(([x, y]) =>
					pic === "si-p" && isMissing(x, y) ? (
						<circle class="hole" cx={x} cy={y} r="4.5" style="stroke:#00a86b" />
					) : (
						<circle class="el" cx={x} cy={y} r="3" />
					),
				),
			)}
			{LY.flatMap((y) =>
				LX.map((x) => {
					const mid = x === 160 && y === 150 && pic !== "si-pure";
					return (
						<>
							<circle class:list={["atom", mid && "odd"]} cx={x} cy={y} r="20" />
							<text class:list={["t b", mid && "gt"]} x={x} y={y + 4.5} text-anchor="middle">
								{mid ? (pic === "si-n" ? "P" : "B") : "Si"}
							</text>
						</>
					);
				}),
			)}
			{pic === "si-n" && <circle class="bigdot" cx="184" cy="124" r="4" />}
			<rect class="legend" x="318" y="34" width="184" height={pic === "si-pure" ? 100 : 164} />
			<circle class="el" cx="334" cy="60" r="3" />
			<text class="s" x="346" y="64">shared electron</text>
			<text class="s" x="330" y="92">each bond has 2 electrons</text>
			<text class="s" x="330" y="116">silicon has 4 outer electrons</text>
			{pic === "si-n" && (
				<>
					<text class="s" x="330" y="140">phosphorus has 5</text>
					<circle class="bigdot" cx="334" cy="172" r="4" />
					<text class="t b gt" x="344" y="176">spare electron</text>
				</>
			)}
			{pic === "si-p" && (
				<>
					<text class="s" x="330" y="140">boron has 3</text>
					<circle class="hole" cx="334" cy="172" r="4.5" style="stroke:#00a86b" />
					<text class="t b gt" x="344" y="176">hole (missing electron)</text>
				</>
			)}
		</svg>
	)
}

{
	pic === "pn-join" && (
		<svg viewBox="0 0 440 230" role="img" aria-label="A block of P-type silicon full of holes, joined on its right to a block of N-type silicon full of free electrons.">
			<rect class="pt" x="40" y="50" width="180" height="120" />
			<rect class="nt" x="220" y="50" width="180" height="120" />
			{holesP.map(([x, y]) => <circle class="hole" cx={x} cy={y} r="4" />)}
			{holesP.map(([x, y]) => <circle class="el" cx={440 - x} cy={y} r="3.5" />)}
			<text class="t b" x="130" y="36" text-anchor="middle">P-type</text>
			<text class="t b" x="310" y="36" text-anchor="middle">N-type</text>
			<text class="t b gt" x="220" y="36" text-anchor="middle">?</text>
			<circle class="hole" cx="48" cy="200" r="4" />
			<text class="s" x="58" y="204">hole</text>
			<circle class="el" cx="110" cy="200" r="3.5" />
			<text class="s" x="120" y="204">free electron</text>
		</svg>
	)
}

{
	pic === "pn-bias" && (
